# Starts without Hamro Pay credentials. Demo mode never moves money.
PAYMENT_MODE=demo
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000

# Switch to sandbox only after filling every required value below.
# Obtain exact endpoint URLs and HTTP methods from Hamro Pay.
HAMRO_MERCHANT_ID=
HAMRO_CLIENT_ID=
HAMRO_API_KEY=
HAMRO_CLIENT_SECRET=
HAMRO_USER_SECRET=
HAMRO_CREATE_SESSION_URL=
HAMRO_CREATE_SESSION_METHOD=
HAMRO_GET_TRANSACTION_URL=
HAMRO_GET_TRANSACTION_METHOD=
HAMRO_GATEWAY_URL=

# Optional signed webhook. Reachable at APP_URL/api/webhooks/hamropay.
HAMRO_WEBHOOK_SECRET=

# Optional platform commission. Set BOTH or leave BOTH empty.
HAMRO_PLATFORM_MERCHANT_ID=
HAMRO_COMMISSION_PERCENTAGE=
