# Starts without Hamro Pay credentials. Demo mode runs the complete checkout flow
# against a gateway built into the sample; it never moves money.
PAYMENT_MODE=demo
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000

# Switch PAYMENT_MODE to sandbox only after filling all four values below.
# Get them from the UAT merchant portal: https://uat-merchant.hamropatro.com/
HAMRO_MERCHANT_ID=
HAMRO_CLIENT_ID=
HAMRO_API_KEY=
HAMRO_CLIENT_SECRET=

# Base URLs only; the sample appends the documented paths:
#   {HAMRO_API_BASE_URL}v1/checkout/sessionId
#   {HAMRO_API_BASE_URL}v1/checkout/transaction
#   {HAMRO_GATEWAY_BASE_URL}api/checkout
# Defaults are the UAT endpoints. Override both for production.
HAMRO_API_BASE_URL=https://uat-payclient.hamropatro.com/
HAMRO_GATEWAY_BASE_URL=https://uat-checkout-pay.hamropatro.com/

# Optional signed webhook (merchantWebHookSigningSecret from the merchant portal).
# Register APP_URL/api/webhooks/hamropay as the endpoint.
HAMRO_WEBHOOK_SECRET=

# Optional Payments for Platforms commission.
# Set HAMRO_PLATFORM_MERCHANT_ID plus exactly one of the two amounts below.
HAMRO_PLATFORM_MERCHANT_ID=
HAMRO_COMMISSION_PERCENTAGE=
HAMRO_COMMISSION_AMOUNT=
